 #include "sm_path_state.h"
 
 // --- Game Metadata Parsing (param.json) ---
+static uint16_t read_le16(const uint8_t *p) {
+  return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+
+static uint32_t read_le32(const uint8_t *p) {
+  return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+         ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static bool range_inside(size_t offset, size_t length, size_t total) {
+  return offset <= total && length <= total - offset;
+}
+
+static bool copy_sfo_text(const uint8_t *buf, size_t len,
+                          uint32_t key_table, uint32_t data_table,
+                          const uint8_t *entry, const char *wanted,
+                          char *out, size_t out_size) {
+  uint16_t key_rel = read_le16(entry);
+  uint16_t format = read_le16(entry + 2);
+  uint32_t value_len = read_le32(entry + 4);
+  uint32_t value_rel = read_le32(entry + 12);
+  size_t key_pos = (size_t)key_table + key_rel;
+  size_t value_pos = (size_t)data_table + value_rel;
+  if (format != 0x0204 || key_pos >= data_table ||
+      !range_inside(value_pos, value_len, len) || value_len == 0)
+    return false;
+  size_t key_room = (size_t)data_table - key_pos;
+  if (!memchr(buf + key_pos, '\0', key_room) ||
+      strcmp((const char *)(buf + key_pos), wanted) != 0 ||
+      buf[value_pos + value_len - 1] != '\0')
+    return false;
+  size_t copy_len = strnlen((const char *)(buf + value_pos), value_len);
+  if (copy_len >= out_size)
+    copy_len = out_size - 1;
+  memcpy(out, buf + value_pos, copy_len);
+  out[copy_len] = '\0';
+  return true;
+}
+
+static bool parse_param_sfo(const uint8_t *buf, size_t len,
+                            char *out_id, char *out_name) {
+  if (len < 20 || memcmp(buf, "\0PSF", 4) != 0)
+    return false;
+  uint32_t key_table = read_le32(buf + 8);
+  uint32_t data_table = read_le32(buf + 12);
+  uint32_t count = read_le32(buf + 16);
+  size_t index_end = 20u + (size_t)count * 16u;
+  if (count > 4096 || index_end < 20 ||
+      index_end > key_table || key_table > data_table || data_table > len)
+    return false;
+
+  const uint8_t *entries = buf + 20;
+  for (uint32_t i = 0; i < count; ++i)
+    (void)copy_sfo_text(buf, len, key_table, data_table, entries + i * 16,
+                        "TITLE_ID", out_id, MAX_TITLE_ID);
+  for (uint32_t i = 0; i < count; ++i)
+    (void)copy_sfo_text(buf, len, key_table, data_table, entries + i * 16,
+                        "TITLE", out_name, MAX_TITLE_NAME);
+  if (out_name[0] == '\0') {
+    char key[16];
+    for (int language = 0; language < 30 && out_name[0] == '\0'; ++language) {
+      snprintf(key, sizeof(key), "TITLE_%02d", language);
+      for (uint32_t i = 0; i < count; ++i)
+        (void)copy_sfo_text(buf, len, key_table, data_table, entries + i * 16,
+                            key, out_name, MAX_TITLE_NAME);
+    }
+  }
+  if (out_id[0] == '\0')
+    return false;
+  if (out_name[0] == '\0')
+    (void)strlcpy(out_name, out_id, MAX_TITLE_NAME);
+  return true;
+}
+
