<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeFrameworkVersion>8.0.26</RuntimeFrameworkVersion>
    <AssemblyName>ps4-dlc-patch</AssemblyName>
    <RootNamespace>ps4_eboot_dlc_patcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DlcPrxTemplateResourceName>ps4_dlc_patch.template.prx</DlcPrxTemplateResourceName>
  </PropertyGroup>

  <ItemGroup Condition="'$(DlcPrxTemplatePath)' != ''">
    <EmbeddedResource Include="$(DlcPrxTemplatePath)"
                      LogicalName="$(DlcPrxTemplateResourceName)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

  <Target Name="RequireExternalDlcPrxTemplate"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DlcPrxTemplatePath)' == ''"
           Text="DlcPrxTemplatePath is required and must point to an upstream-compatible PRX template outside Git." />
    <Error Condition="!Exists('$(DlcPrxTemplatePath)')"
           Text="DlcPrxTemplatePath does not exist: $(DlcPrxTemplatePath)" />
  </Target>
</Project>
