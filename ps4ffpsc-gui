#!/usr/bin/env python3
"""Repository-local launcher for the PS4 FFPFSC desktop application."""
from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "tools" / "ps4ffpsc"))

from ps4ffpsc.gui import main  # noqa: E402

raise SystemExit(main())
